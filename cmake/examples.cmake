# An example: a header that maps a model wrapper onto the targets.
#
#   anira_example(<name>
#       HEADER <Example.h>       defines anira::examples::Example (common/include/anira/examples/Example.h)
#       LINK <target>...         its model libraries (anira::models::<model>)
#       CATALOG <catalog.json>.. its weights on Hugging Face (anira_models_fetch), one or more
#                                (weights(repo) in Weights.h finds each; the first is the default)
#       PRODUCT <name>           the plugin's name
#       CODE <code>              four characters, the first upper-case, the rest lower-case
#       [EMBED]                  the weights compiled into the binary; else copied into the bundle,
#                                <binary dir>/../Resources/models/<repo>
#       [CAMERA])                a camera example (process_frame, overlay): the JUCE target only
#
# ANIRA_EXAMPLES_ONLY (a list of names) builds those examples alone; ANIRA_EXAMPLES_EMBED_ALL
# compiles every example's weights in (an app without a bundle to put them in: the mobile app).
#
# Gives <name>-example (an INTERFACE target: the header, the model libraries, the weights) and, per
# enabled target, <name>-juce (VST3, AU, Standalone), <name>-clap (CLAP, VST3, AUv2) and
# <name>-standalone (CHOC + miniaudio).

include_guard(GLOBAL)

# The examples repository, normalized: catalogs named once (Ninja refuses the same file under two
# spellings).
get_filename_component(_anira_examples_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
# The models submodule, for the examples' catalogs.
set(ANIRA_EXAMPLES_MODELS_DIR "${_anira_examples_dir}/models")

function(anira_example name)
    if(ANIRA_EXAMPLES_ONLY AND NOT name IN_LIST ANIRA_EXAMPLES_ONLY)
        return()
    endif()
    cmake_parse_arguments(PARSE_ARGV 1 _arg "EMBED;CAMERA" "HEADER;PRODUCT;CODE" "LINK;CATALOG")
    if(ANIRA_EXAMPLES_EMBED_ALL)
        set(_arg_EMBED TRUE)
    endif()
    foreach(_required HEADER CATALOG PRODUCT CODE)
        if(NOT _arg_${_required})
            message(FATAL_ERROR "anira_example(${name}): ${_required} is required")
        endif()
    endforeach()
    get_filename_component(_header "${_arg_HEADER}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")

    add_library(${name}-example INTERFACE)
    target_compile_definitions(${name}-example INTERFACE
        ANIRA_EXAMPLE_HEADER="${_header}"
        ANIRA_EXAMPLE_ID="org.anira-project.${name}")
    target_link_libraries(${name}-example INTERFACE anira_examples_common ${_arg_LINK})
    if(_arg_CAMERA)
        target_link_libraries(${name}-example INTERFACE anira_examples_camera)
    endif()

    # Every catalog's weights: compiled in (an embedded_<repo>() each), or a script that copies
    # them into a bundle, <DEST>/<repo>/..., and <ExampleWeights.h>, which finds them by repository.
    set(_copy "")
    set(_script "")
    set(_repos "")
    set(_includes "")
    set(_cases "")
    foreach(_catalog IN LISTS _arg_CATALOG)
        file(READ "${_catalog}" _json)
        string(JSON _repo GET "${_json}" repo)
        get_filename_component(_repo "${_repo}" NAME)
        string(MAKE_C_IDENTIFIER "${_repo}" _id)
        list(APPEND _repos "${_repo}")
        anira_models_fetch("${_catalog}" OUT_DIR _weights OUT_FILES _files)
        if(_arg_EMBED)
            anira_models_embed(${name}-weights-${_id}
                NAMESPACE anira::examples
                SOURCE_DIR "${_weights}"
                FILES ${_files}
                FUNCTION embedded_${_id}
                HEADER ${_id}_weights.h)
            target_link_libraries(${name}-example INTERFACE ${name}-weights-${_id})
            string(APPEND _includes "#include <${_id}_weights.h>\n")
            string(APPEND _cases "    if (repo == \"${_repo}\") { return embedded_${_id}(); }\n")
        else()
            foreach(_file IN LISTS _files)
                get_filename_component(_dir "${_file}" DIRECTORY)
                # A hard link where the cache and the bundle share a volume (no copy of the
                # weights per bundle), else a copy.
                string(APPEND _script
                    "file(MAKE_DIRECTORY \"\${DEST}/${_repo}/${_dir}\")\n"
                    "file(REMOVE \"\${DEST}/${_repo}/${_file}\")\n"
                    "file(CREATE_LINK \"${_weights}/${_file}\" \"\${DEST}/${_repo}/${_file}\" COPY_ON_ERROR)\n")
            endforeach()
        endif()
    endforeach()
    list(GET _repos 0 _first)
    set(_generated "${CMAKE_CURRENT_BINARY_DIR}/${name}-weights-header")
    set(_text "// Generated by anira_example(${name}): where its weights are.\n#pragma once\n\n")
    string(APPEND _text "#include <anira/models/core/ModelSource.h>\n\n#include <string_view>\n\n")
    if(_arg_EMBED)
        string(APPEND _text "#define ANIRA_EXAMPLE_EMBEDDED 1\n${_includes}\n")
    endif()
    string(APPEND _text "namespace anira::examples {\n\n")
    string(APPEND _text "/// The example's first weights' repository (Weights.h's default).\n")
    string(APPEND _text "inline constexpr std::string_view k_weights = \"${_first}\";\n")
    if(_arg_EMBED)
        string(APPEND _text "\n/// The compiled-in weights of `repo`; an empty source for another.\n")
        string(APPEND _text "inline models::core::ModelSource embedded_weights(std::string_view repo) {\n")
        string(APPEND _text "${_cases}    return models::core::ModelSource::bytes({});\n}\n")
    endif()
    string(APPEND _text "\n}  // namespace anira::examples\n")
    file(CONFIGURE OUTPUT "${_generated}/ExampleWeights.h" CONTENT "${_text}" @ONLY)
    target_include_directories(${name}-example INTERFACE "${_generated}")
    if(NOT _arg_EMBED)
        set(_copy "${CMAKE_CURRENT_BINARY_DIR}/${name}-copy-weights.cmake")
        file(WRITE "${_copy}" "${_script}")
    endif()

    # A camera example runs where there is a camera and a view of it: the JUCE app and plugin.
    if(ANIRA_EXAMPLES_WITH_JUCE)
        _anira_example_juce(${name} "${_arg_PRODUCT}" ${_arg_CODE} "${_copy}" ${_arg_CAMERA})
    endif()
    if(_arg_CAMERA)
        return()
    endif()
    if(ANIRA_EXAMPLES_WITH_CLAP)
        _anira_example_clap(${name} "${_arg_PRODUCT}" ${_arg_CODE} "${_copy}")
    endif()
    if(ANIRA_EXAMPLES_WITH_STANDALONE)
        _anira_example_standalone(${name} "${_arg_PRODUCT}" "${_copy}")
    endif()
endfunction()

# After <target> is built: its example's weights into <binary dir>/../Resources/models/<repo>.
function(_anira_example_copy_weights target copy)
    if(copy AND TARGET ${target})
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}"
                    "-DDEST=$<TARGET_FILE_DIR:${target}>/../Resources/models"
                    -P "${copy}"
            VERBATIM)
    endif()
endfunction()

function(_anira_example_juce name product code copy camera)
    if(TANH_OPERATING_SYSTEM STREQUAL "macOS")
        set(_formats AU VST3 Standalone)
    else()
        set(_formats VST3 Standalone)
    endif()
    juce_add_plugin(${name}-juce
        PRODUCT_NAME "${product}"
        COMPANY_NAME "anira-project"
        BUNDLE_ID "org.anira-project.${name}.juce"
        PLUGIN_MANUFACTURER_CODE Anir
        PLUGIN_CODE ${code}
        FORMATS ${_formats}
        HARDENED_RUNTIME_ENABLED TRUE
        HARDENED_RUNTIME_OPTIONS "com.apple.security.device.audio-input"
        MICROPHONE_PERMISSION_ENABLED TRUE
        MICROPHONE_PERMISSION_TEXT "The standalone runs your audio input through the model"
        CAMERA_PERMISSION_ENABLED ${camera}
        CAMERA_PERMISSION_TEXT "The example runs the camera's frames through its models")
    target_sources(${name}-juce PRIVATE
        ${_anira_examples_dir}/targets/juce-plugin/PluginProcessor.cpp
        ${_anira_examples_dir}/targets/juce-plugin/PluginEditor.cpp)
    target_compile_definitions(${name}-juce PRIVATE
        JUCE_WEB_BROWSER=0
        JUCE_USE_CURL=0
        JUCE_VST3_CAN_REPLACE_VST2=0
        JUCE_DISPLAY_SPLASH_SCREEN=0)
    if(TANH_OPERATING_SYSTEM STREQUAL "Linux")
        target_compile_definitions(${name}-juce PRIVATE JUCE_JACK=1)
    endif()
    target_link_libraries(${name}-juce
        PRIVATE
            ${name}-example
            juce::juce_audio_utils
        PUBLIC
            juce::juce_recommended_config_flags
            juce::juce_recommended_warning_flags)
    foreach(_format IN LISTS _formats)
        _anira_example_copy_weights(${name}-juce_${_format} "${copy}")
    endforeach()
endfunction()

function(_anira_example_clap name product code copy)
    add_library(${name}-clap-impl STATIC ${_anira_examples_dir}/targets/clap-plugin/Plugin.cpp)
    target_link_libraries(${name}-clap-impl PUBLIC ${name}-example clap clap-helpers)
    target_compile_definitions(${name}-clap-impl PUBLIC ANIRA_EXAMPLE_PRODUCT="${product}")
    make_clapfirst_plugins(
        TARGET_NAME ${name}-clap
        IMPL_TARGET ${name}-clap-impl
        OUTPUT_NAME "${product}"
        ENTRY_SOURCE ${_anira_examples_dir}/targets/clap-plugin/Entry.cpp
        BUNDLE_IDENTIFIER "org.anira-project.${name}.clap"
        BUNDLE_VERSION "${PROJECT_VERSION}"
        COPY_AFTER_BUILD FALSE
        PLUGIN_FORMATS CLAP VST3 AUV2
        ASSET_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/clap/${name}"
        AUV2_MANUFACTURER_NAME "anira-project"
        AUV2_MANUFACTURER_CODE Anir
        AUV2_SUBTYPE_CODE ${code}
        AUV2_INSTRUMENT_TYPE aufx)
    foreach(_format clap vst3 auv2)
        _anira_example_copy_weights(${name}-clap_${_format} "${copy}")
    endforeach()
endfunction()

function(_anira_example_standalone name product copy)
    add_executable(${name}-standalone MACOSX_BUNDLE
        ${_anira_examples_dir}/targets/standalone/Main.cpp)
    target_link_libraries(${name}-standalone PRIVATE ${name}-example anira_examples_standalone)
    set_target_properties(${name}-standalone PROPERTIES
        OUTPUT_NAME "${product}"
        MACOSX_BUNDLE_GUI_IDENTIFIER "org.anira-project.${name}.standalone"
        MACOSX_BUNDLE_BUNDLE_NAME "${product}"
        MACOSX_BUNDLE_BUNDLE_VERSION "${PROJECT_VERSION}"
        MACOSX_BUNDLE_SHORT_VERSION_STRING "${PROJECT_VERSION}"
        MACOSX_BUNDLE_INFO_PLIST ${_anira_examples_dir}/targets/standalone/Info.plist.in)
    _anira_example_copy_weights(${name}-standalone "${copy}")
endfunction()
